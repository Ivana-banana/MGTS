Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Tree Height: 400
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 120; 120; 120
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Map 3D (/mgts/map)
      Enabled: true
      Topic:
        Value: /mgts/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Autocompute Value Bounds: false
      Min Value: -0.2
      Max Value: 2.0
      Alpha: 0.6
      Decay Time: 0
      Queue Size: 2
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Current sweep in map (/mgts/scan_map)
      Enabled: true
      Topic:
        Value: /mgts/scan_map
        Depth: 5
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Spheres
      Size (Pixels): 4
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Alpha: 1
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Not in map: people / new obstacles (/mgts/dynamic_points)
      Enabled: true
      Topic:
        Value: /mgts/dynamic_points
        Depth: 5
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Spheres
      Size (Pixels): 6
      Size (m): 0.1
      Color Transformer: FlatColor
      Color: 255; 0; 255
      Alpha: 1
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Raw odometry (/mgts/odom_path)
      Enabled: true
      Topic:
        Value: /mgts/odom_path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color: 255; 200; 0
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.04
      Buffer Length: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Localized trajectory (/mgts/path)
      Enabled: true
      Topic:
        Value: /mgts/path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color: 255; 40; 40
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.06
      Buffer Length: 1
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Pose (/mgts/pose)
      Enabled: true
      Topic:
        Value: /mgts/pose
        Depth: 5
        Reliability Policy: Reliable
        History Policy: Keep Last
      Shape: Arrow
      Color: 255; 25; 0
      Shaft Length: 0.6
      Shaft Radius: 0.06
      Head Length: 0.25
      Head Radius: 0.15
      Alpha: 1
      Covariance:
        Value: true
        Position:
          Value: true
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1
        Orientation:
          Value: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.6
      Frames:
        All Enabled: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 36
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Name: Third person
      Distance: 7
      Focal Point:
        X: 0
        Y: 0
        Z: 0.3
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Near Clip Distance: 0.01
      Pitch: 0.55
      Yaw: 3.14159
      Target Frame: base_link
      Value: ThirdPersonFollower (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1080
  Width: 1920
  Hide Left Dock: false
  Hide Right Dock: true
  Time:
    collapsed: false
